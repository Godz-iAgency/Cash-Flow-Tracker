# Leave cloud settings empty for on-device mode. Legacy Sheets mode still works.
# Recommended: firestore (requires all FIREBASE settings below).
STORAGE_BACKEND=
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
FIREBASE_OWNER_EMAIL=
# Absolute path to a PRIVATE Admin JSON file OUTSIDE this repository.
# Never paste its contents into a browser or commit it.
FIREBASE_SERVICE_ACCOUNT_PATH=
PORT=3001
# A long, unique password. Never expose this application without HTTPS.
APP_PASSWORD=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Copy the ID between /d/ and /edit. With Firestore this is a report destination.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the service account private key with literal \n for line breaks.
GOOGLE_PRIVATE_KEY=
# Optional. Enables Gemini transaction drafts; confirmation is always required.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
