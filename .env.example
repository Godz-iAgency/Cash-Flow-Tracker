# Leave Sheets settings empty to use the clearly labeled, on-device mode.
PORT=3001
# A long, unique password. Never expose this application without HTTPS.
APP_PASSWORD=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Copy the ID between /d/ and /edit in your spreadsheet URL.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the service account private key with literal \n for line breaks.
GOOGLE_PRIVATE_KEY=
# Optional. Enables Gemini transaction drafts; confirmation is always required.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
